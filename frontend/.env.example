# Copy to .env.local. NEXT_PUBLIC_* values are baked into the bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Auth (Google sign-in). Leave empty for local dev: the nav bar then shows the
# "Dev user" box and requests carry X-User-Id. When set, the backend needs
# FIREBASE_PROJECT_ID set to the same project. These are public web config values, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
