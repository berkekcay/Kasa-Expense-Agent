# Copy to .env on the Droplet (setup.sh does this and fills in the generated values).
# Never commit .env and never paste these values in a chat or an issue.

# Your domain (point an A record at the Droplet), or <ip-with-dashes>.sslip.io, e.g.
# 203-0-113-10.sslip.io for 203.0.113.10. Caddy gets the HTTPS certificate for it.
DOMAIN=
ACME_EMAIL=

# SQL Server. Passwords: at least 10 characters with upper, lower and digits.
MSSQL_SA_PASSWORD=
KASA_APP_PASSWORD=
MSSQL_IMAGE_TAG=2022-latest
MSSQL_MEMORY_LIMIT_MB=1536

# App secrets (python -m app.services.crypto; python -c "import secrets; print(secrets.token_urlsafe(32))")
TOKEN_ENCRYPTION_KEY=
AUTH_SECRET=

# Gemini (https://aistudio.google.com/apikey). Empty = the chat and receipt reading are off.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google sign-in and Gmail. Redirect URIs to add in Google Cloud:
#   https://DOMAIN/api/auth/google/callback and https://DOMAIN/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
