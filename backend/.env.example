# Copy to .env (never commit .env). Everything is optional for local dev.

# --- Database --------------------------------------------------------------------------------
# Local dev: SQLite file next to the backend. Prod (Cloud Run) example:
# DATABASE_URL=mssql+pyodbc://kasa_app:<password>@<host>:1433/kasa?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
DATABASE_URL=sqlite:///./kasa.db
# true = run `alembic upgrade head` on startup (dev). Prod: false, and migrate as a deploy step
# with an admin login in MIGRATION_DATABASE_URL (the app login cannot run DDL).
AUTO_MIGRATE=true
MIGRATION_DATABASE_URL=

# --- LLM provider ----------------------------------------------------------------------------
# gemini (product default) or ollama (dev/tests; needs `pip install -r requirements-dev.txt`).
LLM_PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com/apikey). With gemini and no key,
# /receipts and /chat return 503.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Model for receipt images; empty = GEMINI_MODEL.
GEMINI_VISION_MODEL=
# Ollama, e.g. http://localhost:11434 or a LAN server.
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REASONING_EFFORT=low

# --- HTTP ------------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Web UI address; the Google OAuth callback redirects back here.
FRONTEND_URL=http://localhost:3000

# --- Auth ------------------------------------------------------------------------------------
# Set to require Firebase ID tokens. Empty = dev mode (X-User-Id header, never in prod).
FIREBASE_PROJECT_ID=
# Dev mode: user id used when a request has no X-User-Id header.
DEV_DEFAULT_USER_ID=dev-user
# Kasa accounts (email + password or Google, Google Authenticator 2FA always on).
# dev = X-User-Id also works when there is no session (local, tests);
# accounts = a sign-in session is required (production, the demo).
AUTH_MODE=dev
# Signs the 10-minute steps between password and 2FA code and the Google sign-in state.
# Set a long random value in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
SESSION_DAYS=30
# Sign in with Google uses the Google OAuth client below with this extra redirect URI
# (add it to the OAuth client in Google Cloud). Needs TOKEN_ENCRYPTION_KEY too.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Google OAuth (Gmail import + Calendar reminders) ----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/callback
# Space- or comma-separated; empty uses openid, email, gmail.readonly, calendar.events.
# GOOGLE_OAUTH_SCOPES=
# Fernet key for stored refresh tokens and 2FA secrets (required for accounts):
# python -m app.services.crypto
TOKEN_ENCRYPTION_KEY=

# --- Gmail sync ------------------------------------------------------------------------------
# GMAIL_QUERY=  (leave unset to use the default in app/config.py: order, invoice, receipt and card-spend subjects from the last 30 days)
GMAIL_SYNC_MAX_MESSAGES=50
# projects/<project>/topics/<topic> that Gmail publishes to
PUBSUB_TOPIC=
# Push subscription OIDC settings checked on POST /internal/gmail/push
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# --- Internal endpoints (Cloud Scheduler) ----------------------------------------------------
# Shared secret sent as X-Kasa-Task-Token. Empty disables /internal/*.
INTERNAL_TASK_TOKEN=

# --- Money -----------------------------------------------------------------------------------
BASE_CURRENCY=TRY
TCMB_BASE_URL=https://www.tcmb.gov.tr/kurlar
MAX_UPLOAD_BYTES=10485760
REPORT_ROW_LIMIT=200
