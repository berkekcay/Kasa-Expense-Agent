# Copy to .env (never commit .env). All values are optional for local dev.

# Local dev: SQLite file next to the backend. Prod (Cloud Run) example:
# DATABASE_URL=mssql+pyodbc://kasa_app:<password>@<host>:1433/kasa?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
DATABASE_URL=sqlite:///./kasa.db

# Google AI Studio key (https://aistudio.google.com/apikey). Empty = /receipts and /chat return 503.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Sprint-1 dev auth: user id used when a request has no X-User-Id header.
DEV_DEFAULT_USER_ID=dev-user
